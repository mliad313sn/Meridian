# Copy to `.env` — the server, the seed and every script load it (I-1).
# A variable already set in the shell always wins over this file.

# Point at a real PostgreSQL cluster in any environment that has one.
# Leave unset and the server runs PGlite (PostgreSQL/WASM) from PGLITE_DIR.
# DATABASE_URL=postgres://meridian:secret@localhost:5432/meridian

# Where the PGlite book lives. This is also the default when unset, so a
# fresh clone keeps its data without any configuration. Created if missing.
PGLITE_DIR=./server/.data/pgdata

# In-memory book, lost when the process stops. Never a silent default:
# it has to be asked for, and /api/health says `ephemeral: true`.
# MERIDIAN_EPHEMERAL=1

PORT=4173
NODE_ENV=development

# Production posture (docs/34-exploitation.md):
#   NODE_ENV=production refuses PGlite unless MERIDIAN_ALLOW_PGLITE=1, and
#   refuses to start while a seeded demo password still opens an active
#   account unless MERIDIAN_ALLOW_DEMO_ACCOUNTS=1.
# MERIDIAN_REQUIRE_POSTGRES=1
# MERIDIAN_BIND=0.0.0.0
# MERIDIAN_SECURE_COOKIES=1
